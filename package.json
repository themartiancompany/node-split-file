{
  "name":
    "@themartiancompany/split-file",
  "version":
    "2.3.20",
  "private":
    false,
  "description":
    "Splitting and merging files with NodeJS.",
  "homepage":
    "https://github.com/themartiancompany/node-split-file",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/node-split-file/issues"
  },
  "author": 
    { "name":
        "Pellegrino Prevete",
      "email":
        "pellegrinoprevete@gmail.com",
      "url":
        "https://github.com/tallero" },
  "contributors": [
    { "name":
        "Tom Valk",
      "email":
        "tomvalk@lt-box.info" }
  ],
  "license":
    "AGPL3",
  "keywords": [
    "opfs",
    "split",
    "file",
    "stream"
  ],
  "files": [
    "COPYING",
    "AUTHORS.rst",
    "README.md",
    "dist",
    "eslint-config.mjs",
    "libsplit-file",
    "man",
    "split-file",
    "package.json",
    "webpack.config.cjs"
  ],
  "bin": {
    "split-file":
      "./split-file"
  },
  "main":
    "./libsplit-file",
  "man":
    "./man/split-file.1",
  "type":
    "module",
  "repository": {
    "type":
      "git",
    "url":
      "https://github.com:themartiancompany/node-split-file.git"
  },
  "dependencies": {
    "bluebird":
      "^3.7.2"
  },
  "devDependencies": {
    "crash-js-webpack":
      "^0.0.63",
    "debug":
      "^4.4.3",
    "diff":
      "^9.0.0",
    "eslint":
      "^10.9.0",
    "@eslint/js":
      "^10.0.1",
    "glob":
      "^13.0.6",
    "inflight":
      "npm:lru-cache@^11.5.2",
    "jest":
      "^30.4.2",
    "mocha":
      "^11.8.0",
    "globals":
      "^17.3.0",
    "serialize-javascript":
      "^7.1.0",
    "safely-serve":
      "^0.0.18",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "overrides": {
    "debug":
      "^4.4.3",
    "diff":
      "^9.0.0",
    "glob":
      "^13.0.6",
    "inflight":
      "npm:lru-cache@^11.5.2",
    "serialize-javascript":
      "^7.1.0"
  },
  "scripts": {
    "prebuild":
      "npm run lint",
    "build":
      "npm run build-fs-worker; npm run build-lib",
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details && for _target in 'libsplit-file'; do cp 'fs-worker.js' 'dist/'${_target}; done",
    "build-lib":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && cp 'libsplitfile.js' 'dist/libsplitfile'",
    "lint":
      "npx eslint .",
    "test":
      "jest --runInBand",
    "start":
      "npx safely-serve 'dist/libsplit-file'"
  }
}
